<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Views\" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\workflows\release-on-tag.yml" />
    <EmbeddedResource Include="Resources\map.html" />
    <!-- Kopiere Lizenzdateien bei Build ins Output-Verzeichnis -->
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-LICENSES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="licenses\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="licenses\" />
  </ItemGroup>

</Project>

