<Window x:Class="PictureExifclone.LicenseViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lizenzen" Height="700" Width="900" WindowStartupLocation="CenterOwner"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#FF2196F3" Padding="15" CornerRadius="5" Margin="0,0,0,10"><TextBlock Text="Lizenzinformationen" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/></Border><TabControl Grid.Row="1"><TabItem Header="LICENSE (MIT)"><ScrollViewer><TextBox Name="LicenseTextBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" Margin="10"/></ScrollViewer></TabItem><TabItem Header="Third-Party"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Name="LicensesInfoTextBlock" Text="Lade..." FontSize="11"/><ScrollViewer Grid.Row="1" Margin="0,10,0,10"><TextBox Name="ThirdPartyTextBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"/></ScrollViewer><Button Grid.Row="2" Name="OpenLicensesFolderButton" Content="licenses-Ordner oeffnen" Height="35" Click="OpenLicensesFolderButton_Click"/></Grid></TabItem></TabControl><Button Grid.Row="2" Name="CloseButton" Content="Schliessen" Width="100" Height="35" HorizontalAlignment="Right" Click="CloseButton_Click"/></Grid></Window>
