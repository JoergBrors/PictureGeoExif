<Window x:Class="PictureExifclone.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bild bearbeiten" Height="800" Width="1000" WindowStartupLocation="CenterOwner"
        WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Zoom Controls -->
        <Border Grid.Row="0" Background="#FFF0F0F0">
            <StackPanel Orientation="Horizontal" Margin="10,5" HorizontalAlignment="Center">
                <Button Content="Zoom Out" Width="80" Height="35" Click="ZoomOut_Click" Margin="5"/>
                <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold" MinWidth="60" TextAlignment="Center" FontSize="16"/>
                <Button Content="Zoom In" Width="80" Height="35" Click="ZoomIn_Click" Margin="5"/>
                <Button Content="Anpassen" Width="100" Height="35" Click="ZoomFit_Click" Margin="5"/>
                <Separator Width="20" Background="Transparent"/>
                <Button Content="Zuschneiden" Height="35" Click="Crop_Click" Margin="5" Padding="10,0"/>
            </StackPanel>
        </Border>

        <!-- Image Display with ScrollViewer -->
        <Border Grid.Row="1" Margin="10,5,10,10" BorderBrush="#FFCCCCCC" BorderThickness="1" Background="#FFF5F5F5">
            <ScrollViewer x:Name="ImageScrollViewer" 
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto"
                          Background="White">
                <Canvas x:Name="ImageCanvas" 
                        Background="White"
                        MouseLeftButtonDown="ImageCanvas_MouseDown"
                        MouseMove="ImageCanvas_MouseMove"
                        MouseLeftButtonUp="ImageCanvas_MouseUp">
                    <Image x:Name="EditorImage" 
                           Stretch="None" 
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                    </Image>
                    <!-- Crop Rectangle -->
                    <Rectangle x:Name="CropRectangle" 
                               Stroke="Red" 
                               StrokeThickness="3" 
                               StrokeDashArray="5 3"
                               Fill="#20FF0000" 
                               Visibility="Collapsed" 
                               IsHitTestVisible="False"/>
                </Canvas>
            </ScrollViewer>
        </Border>

        <!-- Edit Controls -->
        <Border Grid.Row="2" Background="#FFF0F0F0" BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="10,10,10,10" HorizontalAlignment="Center">
                <TextBox x:Name="TextOverlayInput" 
                         Width="250" 
                         Height="30" 
                         Margin="5" 
                         VerticalContentAlignment="Center"/>
                <Button Content="Text einfuegen" Click="AddText_Click" Margin="5" Padding="10,5" Height="30"/>
                <Button Content="Geo-Wasserzeichen" Click="AddGeoWatermark_Click" Margin="5" Padding="10,5" Height="30"/>
                <Button Content="Verpixeln" Click="PixelateFaces_Click" Margin="5" Padding="10,5" Height="30"/>
                <Separator Width="20" Background="Transparent"/>
                <Button Content="Speichern" Click="Save_Click" Margin="5" Background="#FF4CAF50" Foreground="White" FontWeight="Bold" Padding="20,5" Height="30"/>
                <Button Content="Abbrechen" Click="Cancel_Click" Margin="5" Padding="15,5" Height="30"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
