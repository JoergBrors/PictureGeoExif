<Window x:Class="PictureExifclone.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PictureExifclone.Controls"
        Title="Bildeditor" Height="850" Width="1300" 
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#FF2C2C2C">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- Toolbar oben -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#FF3C3C3C" BorderBrush="#FF555555" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <GroupBox Header="Zoom" Foreground="White" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="-" Width="35" Height="30" Click="ZoomOut_Click" Margin="2"/>
                        <TextBlock x:Name="ZoomText" Text="100%" Width="55" TextAlignment="Center" 
                                   Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="+" Width="35" Height="30" Click="ZoomIn_Click" Margin="2"/>
                        <Button Content="Fit" Width="50" Height="30" Click="ZoomFit_Click" Margin="2"/>
                    </StackPanel>
                </GroupBox>

                <Button x:Name="UndoButton" Content="? UNDO" Width="120" Height="35" Margin="5" Click="Undo_Click"
                        Background="#FF4CAF50" Foreground="White" FontWeight="Bold" IsEnabled="False"/>

                <Button Content="EXIF Daten anzeigen" Width="140" Height="35" Margin="5" Click="ShowExif_Click"
                        Background="#FF9C27B0" Foreground="White" FontWeight="Bold"/>
                
                <Separator Width="20" Background="Transparent"/>
                
                <Button Content="Speichern" Width="120" Height="40" Margin="5" Click="Save_Click"
                        Background="#FF28A745" Foreground="White" FontWeight="Bold" FontSize="16"/>
                <Button Content="Abbrechen" Width="120" Height="40" Margin="5" Click="Cancel_Click"
                        Background="#FFDC3545" Foreground="White" FontWeight="Bold" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Linke Spalte: Werkzeuge und Eigenschaften -->
        <Border Grid.Row="1" Grid.Column="0" Background="#FF2C2C2C" BorderBrush="#FF555555" BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Margin="10">
                    <TextBlock Text="WERKZEUGE" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                    
                    <!-- Text-Werkzeug -->
                    <Border Background="#FF3C3C3C" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <StackPanel>
                            <RadioButton x:Name="ModeText" Content="Text einfuegen" Foreground="White" 
                                         FontSize="14" FontWeight="Bold" IsChecked="True" GroupName="Mode"
                                         Margin="0,0,0,10"/>
                            
                            <TextBlock Text="1. Text eingeben:" Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="TextInput" Height="60" TextWrapping="Wrap" 
                                     Background="#FF2C2C2C" Foreground="White" Padding="5" Margin="0,0,0,10"
                                     BorderBrush="#FF555555"/>
                            
                            <TextBlock Text="2. Schriftgroesse waehlen:" Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,0,5"/>
                            <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="120" Value="48" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Value, ElementName=FontSizeSlider, StringFormat={}{0:F0} px}" 
                                       Foreground="White" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="3. Farbe waehlen:" Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,0,5"/>
                            <local:SimpleColorPicker x:Name="TextColorPicker" Height="35" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="4. Auf Bild klicken wo Text hin soll" Foreground="#FFFF9800" FontSize="11" 
                                       TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="Bold"/>
                            
                            <Button Content="5. TEXT EINFUEGEN" Height="40" Click="ApplyText_Click"
                                    Background="#FF2196F3" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Geo-Werkzeug -->
                    <Border Background="#FF3C3C3C" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <StackPanel>
                            <RadioButton x:Name="ModeGeo" Content="Geo-Wasserzeichen" Foreground="White" 
                                         FontSize="14" FontWeight="Bold" GroupName="Mode"
                                         Margin="0,0,0,10"/>
                            
                            <TextBlock Text="1. Groesse waehlen:" Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,0,5"/>
                            <Slider x:Name="GeoSizeSlider" Minimum="12" Maximum="80" Value="32" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Value, ElementName=GeoSizeSlider, StringFormat={}{0:F0} px}" 
                                       Foreground="White" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="2. Farbe waehlen:" Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,0,5"/>
                            <local:SimpleColorPicker x:Name="GeoColorPicker" Height="35" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="3. Auf Bild klicken wo GPS-Daten hin sollen" Foreground="#FFFF9800" FontSize="11" 
                                       TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="Bold"/>
                            
                            <Button Content="4. GEO-DATEN EINFUEGEN" Height="40" Click="ApplyGeo_Click"
                                    Background="#FF4CAF50" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Verpixeln-Werkzeug -->
                    <Border Background="#FF3C3C3C" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <StackPanel>
                            <RadioButton x:Name="ModePixelate" Content="Bereich verpixeln" Foreground="White" 
                                         FontSize="14" FontWeight="Bold" GroupName="Mode"
                                         Margin="0,0,0,10"/>
                            
                            <TextBlock Text="1. Pixel-Groesse waehlen:" Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,0,5"/>
                            <Slider x:Name="PixelSizeSlider" Minimum="5" Maximum="50" Value="20" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Value, ElementName=PixelSizeSlider, StringFormat={}{0:F0} px}" 
                                       Foreground="White" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>
                            

                            <TextBlock Text="2. Mit Maus Rechteck auf Bild ziehen" Foreground="#FFFF9800" FontSize="11" 
                                       TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="Bold"/>
                            
                            <Button Content="3. BEREICH VERPIXELN" Height="40" Click="ApplyPixelate_Click"
                                    Background="#FFFF5722" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Crop-Werkzeug -->
                    <Border Background="#FF3C3C3C" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <StackPanel>
                            <RadioButton x:Name="ModeCrop" Content="Bild zuschneiden" Foreground="White" 
                                         FontSize="14" FontWeight="Bold" GroupName="Mode"
                                         Margin="0,0,0,10"/>
                            

                            <TextBlock Text="1. Mit Maus Rechteck aufziehen (was behalten werden soll)" Foreground="#FFFF9800" FontSize="11" 
                                       TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="Bold"/>
                            

                            <Button Content="2. BILD ZUSCHNEIDEN" Height="40" Click="ApplyCrop_Click"
                                    Background="#FF9C27B0" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Mittlere Spalte: Bild (zentriert) -->
        <Border Grid.Row="1" Grid.Column="1" Background="#FF1C1C1C">
            <ScrollViewer x:Name="ImageScrollViewer" 
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
                <Grid x:Name="ImageContainer" 
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    
                    <!-- Main Image -->
                    <Image x:Name="DisplayImage" 
                           Stretch="None"
                           MouseLeftButtonDown="Image_MouseDown"
                           MouseMove="Canvas_MouseMove"
                           MouseLeftButtonUp="Canvas_MouseUp"
                           Cursor="Cross"
                           Panel.ZIndex="1"/>
                    
                    <!-- Preview Canvas for Markers -->
                    <Canvas x:Name="PreviewCanvas" 
                            IsHitTestVisible="False"
                            Panel.ZIndex="2">
                        <!-- Click Position Marker -->
                        <Ellipse x:Name="ClickMarker"
                                 Width="20" Height="20"
                                 Fill="Red"
                                 Stroke="White"
                                 StrokeThickness="2"
                                 Visibility="Collapsed"/>
                        
                        <!-- Selection Rectangle -->
                        <Rectangle x:Name="SelectionRect" 
                                   Stroke="Red" 
                                   StrokeThickness="2" 
                                   StrokeDashArray="5 3"
                                   Fill="Transparent" 
                                   Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Rechte Spalte: Info -->
        <Border Grid.Row="1" Grid.Column="2" Background="#FF2C2C2C" BorderBrush="#FF555555" BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Margin="10">
                    <TextBlock Text="INFORMATIONEN" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Bild:" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ImageInfoText" Foreground="#FFAAAAAA" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="GPS:" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="GpsInfoText" Foreground="#FFAAAAAA" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Bedienung:" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Border Background="#FF3C3C3C" Padding="10" CornerRadius="5">
                        <TextBlock Foreground="#FFAAAAAA" TextWrapping="Wrap" FontSize="11">
                            <Run Text="ZOOM:" FontWeight="Bold"/><LineBreak/>
                            STRG + Mausrad = Zoomen<LineBreak/>
                            +/- Buttons = Stufen<LineBreak/>
                            Fit = An Fenster anpassen<LineBreak/>
                            <LineBreak/>
                            <Run Text="UNDO:" FontWeight="Bold"/><LineBreak/>
                            Macht letzte Aenderung rueckgaengig<LineBreak/>
                            Bis zu 10 Schritte moeglich<LineBreak/>
                            <LineBreak/>
                            <Run Text="WERKZEUGE:" FontWeight="Bold"/><LineBreak/>
                            1. Werkzeug links waehlen<LineBreak/>
                            2. Einstellungen vornehmen<LineBreak/>
                            3. Auf Bild klicken/ziehen<LineBreak/>
                            4. Button zum Anwenden klicken<LineBreak/>
                            5. Undo bei Bedarf
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Statusleiste -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#FF3C3C3C" BorderBrush="#FF555555" BorderThickness="0,1,0,0" Padding="8">
            <Grid>
                <TextBlock x:Name="StatusText" Foreground="White" FontSize="11" HorizontalAlignment="Left"/>
                <TextBlock x:Name="PositionText" Foreground="#FFAAAAAA" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
