<Window x:Class="PictureExifclone.ImageEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PictureExifclone.Controls"
 Title="Bildeditor" Width="1300" Height="850" MinWidth="850" MinHeight="550" WindowStartupLocation="CenterOwner"
 Background="#F3F5F8" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,10">
   <Button Content="−" Click="ZoomOut_Click"/><TextBlock x:Name="ZoomText" Text="100 %" VerticalAlignment="Center" Margin="8"/>
   <Button Content="+" Click="ZoomIn_Click"/><Button Content="Einpassen" Click="ZoomFit_Click"/><Button Content="100 %" Click="ZoomActual_Click"/>
   <Button Content="↶ Links" Click="RotateLeft_Click"/><Button Content="↷ Rechts" Click="RotateRight_Click"/>
   <Button x:Name="UndoButton" Content="Rückgängig" Click="Undo_Click" IsEnabled="False"/>
   <Button x:Name="RedoButton" Content="Wiederholen" Click="Redo_Click" IsEnabled="False"/>
   <Button Content="Original / Bearbeitet" Click="Compare_Click"/><Button Content="EXIF" Click="ShowExif_Click"/>
   <Button Content="Speichern" Click="Save_Click"/><Button Content="Abbrechen" Click="Cancel_Click"/>
  </WrapPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="245" MinWidth="210"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
    <TextBlock Text="BILDWERKZEUGE" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock x:Name="ImageInfoText" TextWrapping="Wrap"/><TextBlock x:Name="GpsInfoText" TextWrapping="Wrap" Margin="0,6,0,16"/>
    <RadioButton x:Name="ModeCrop" Content="Zuschneiden" GroupName="Tool" IsChecked="True" Checked="ToolChanged"/>
    <RadioButton x:Name="ModeBlur" Content="Unschärfe (Blur)" GroupName="Tool" Checked="ToolChanged"/>
    <RadioButton x:Name="ModePixelate" Content="Verpixeln" GroupName="Tool" Checked="ToolChanged"/>
    <TextBlock Text="Bereich auf dem Bild aufziehen. Auch 1 × 1 Pixel und alle Bildränder sind auswählbar." TextWrapping="Wrap" Margin="0,8"/>
    <TextBlock Text="Effektstärke (% der kurzen Auswahlkante)" TextWrapping="Wrap"/>
    <Slider x:Name="EffectSize" Minimum="0.5" Maximum="30" Value="5"/>
    <TextBlock Text="{Binding Value, ElementName=EffectSize, StringFormat={}{0:F1} %}"/>
    <Separator Margin="0,12"/>
    <RadioButton x:Name="ModeText" Content="Text" GroupName="Tool" Checked="ToolChanged"/>
    <TextBox x:Name="WatermarkTextBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6"/>
    <RadioButton x:Name="ModeGeo" Content="GPS-Stempel" GroupName="Tool" Checked="ToolChanged"/>
    <TextBlock Text="Stempelgröße (% der kurzen Bildkante)" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <Slider x:Name="StampSize" Minimum="0.5" Maximum="15" Value="3"/>
    <TextBlock Text="{Binding Value, ElementName=StampSize, StringFormat={}{0:F1} %}"/>
    <local:SimpleColorPicker x:Name="StampColor" Height="35" Margin="0,8"/>
    <TextBlock Text="Position: ins Bild klicken oder Ecke wählen" TextWrapping="Wrap"/>
    <ComboBox x:Name="StampAnchor" SelectedIndex="0" Margin="0,8">
     <ComboBoxItem Content="Klickposition"/><ComboBoxItem Content="Oben links"/><ComboBoxItem Content="Oben rechts"/>
     <ComboBoxItem Content="Unten links"/><ComboBoxItem Content="Unten rechts"/>
    </ComboBox>
    <Button Content="Vorschau" Click="Preview_Click"/><Button Content="Anwenden" Click="Apply_Click"/>
    <Button Content="Auswahl / Vorschau löschen" Click="Clear_Click"/>
    <Separator Margin="0,12"/>
    <TextBlock Text="Exportformat"/><ComboBox x:Name="ExportFormat" SelectedIndex="0" Margin="0,6">
     <ComboBoxItem Content="PNG (verlustfrei)" Tag=".png"/><ComboBoxItem Content="JPEG" Tag=".jpg"/>
     <ComboBoxItem Content="TIFF" Tag=".tif"/><ComboBoxItem Content="BMP" Tag=".bmp"/>
    </ComboBox>
    <TextBlock Text="JPEG-Qualität"/><Slider x:Name="JpegQuality" Minimum="1" Maximum="100" Value="95"/>
    <TextBlock Text="Strg+Mausrad: Zoom · Strg+Z/Y: Verlauf · Escape: Auswahl verwerfen" TextWrapping="Wrap" Margin="0,14"/>
   </StackPanel></ScrollViewer>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"/>
   <ScrollViewer Grid.Column="2" x:Name="ImageScrollViewer" Background="#252B36" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
     PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel" SizeChanged="ViewportChanged">
    <Grid x:Name="ImageContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
      MouseLeftButtonDown="Image_MouseDown" MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp" LostMouseCapture="LostCapture">
     <Grid.LayoutTransform><ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
     <Image x:Name="DisplayImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
     <Canvas IsHitTestVisible="False" ClipToBounds="True">
      <Rectangle x:Name="SelectionRect" Stroke="#FFAA22" Fill="#22FFAA22" StrokeThickness="1" Visibility="Collapsed"/>
      <Ellipse x:Name="ClickMarker" Width="8" Height="8" Stroke="White" Fill="#F05A44" Visibility="Collapsed"/>
     </Canvas>
    </Grid>
   </ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="StatusText" Text="Bild wird geladen …" Margin="0,10,0,0" TextWrapping="Wrap"/>
  <Border x:Name="BusyOverlay" Grid.RowSpan="3" Background="#CCF3F5F8" Visibility="Collapsed">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Bild wird verarbeitet …" FontSize="22"/>
    <Button Content="Vorgang abbrechen" Click="CancelOperation_Click"/></StackPanel>
  </Border>
 </Grid>
</Window>
