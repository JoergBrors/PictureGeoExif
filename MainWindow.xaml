<Window x:Class="PictureExifclone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PictureExifclone"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Bild Georeferenzierung" Height="700" Width="1200"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Linke Spalte: Bildliste und Steuerung -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Background="#FF2196F3" Margin="0,0,0,10">
                <TextBlock Text="Bild Georeferenzierung" 
                           FontSize="20" FontWeight="Bold" 
                           Foreground="White" Margin="10" 
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Bildliste -->
            <Border Grid.Row="1" BorderBrush="#FFCCCCCC" BorderThickness="1" 
                    Margin="10,0,10,10" Background="#FFF5F5F5">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="ImageListBox" 
                                 SelectionChanged="ImageListBox_SelectionChanged"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFDDDDDD" BorderThickness="1" 
                                            Margin="5" Padding="5" Background="White">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Image Grid.Row="0" Source="{Binding Thumbnail}" 
                                                   Height="100" Stretch="Uniform" Margin="0,0,0,5"/>
                                            <TextBlock Grid.Row="1" Text="{Binding FileName}" 
                                                       FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="{Binding GpsInfo}" 
                                                       FontSize="10" Foreground="#FF666666"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Drag & Drop Hinweis -->
                    <TextBlock x:Name="DropHintText" 
                               Text="Ziehen Sie Bilder hierher&#x0a;oder klicken Sie auf 'Bilder laden'"
                               FontSize="14" Foreground="#FF999999" 
                               TextAlignment="Center" VerticalAlignment="Center"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               Margin="20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=ImageListBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Margin="10,0,10,10">
                <Button x:Name="LoadImagesButton" Content="Bilder laden" 
                        Height="40" Margin="0,0,0,5" Click="LoadImagesButton_Click"
                        Background="#FF4CAF50" Foreground="White" FontWeight="Bold"/>
                <Button x:Name="EditImageButton" Content="Bild bearbeiten" 
                        Height="35" Margin="0,0,0,5" Click="EditImageButton_Click"
                        IsEnabled="False"/>
                <Button x:Name="UseReferenceImageButton" Content="Referenzbild verwenden" 
                        Height="35" Margin="0,0,0,5" Click="UseReferenceImageButton_Click"/>
                <Button x:Name="SaveAllButton" Content="Alle speichern" 
                        Height="40" Margin="0,0,0,5" Click="SaveAllButton_Click"
                        Background="#FF2196F3" Foreground="White" FontWeight="Bold"
                        IsEnabled="False"/>
            </StackPanel>

            <!-- GPS Info -->
            <Border Grid.Row="3" Background="#FFFFE082" Padding="10" Margin="10,0,10,10">
                <StackPanel>
                    <TextBlock Text="Aktuelle GPS-Koordinaten:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="CurrentGpsText" Text="Keine Koordinaten ausgewählt" 
                               TextWrapping="Wrap"/>
                    <Button x:Name="ApplyGpsButton" Content="GPS auf ausgewähltes Bild anwenden" 
                            Height="30" Margin="0,10,0,0" Click="ApplyGpsButton_Click"
                            IsEnabled="False"/>
                </StackPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                      Background="#FFCCCCCC"/>

        <!-- Rechte Spalte: Karte -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="OpenStreetMap - Klicken Sie auf die Karte, um Koordinaten auszuwählen" 
                       FontSize="14" FontWeight="Bold" Margin="10" 
                       HorizontalAlignment="Center"/>

            <wv2:WebView2 x:Name="MapWebView" Grid.Row="1" 
                          Margin="10"/>
        </Grid>
    </Grid>
</Window>
