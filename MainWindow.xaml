<Window x:Class="PictureExifclone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PictureExifclone"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Bild Georeferenzierung" Height="850" Width="1400" MinWidth="900" MinHeight="650"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Window.Resources>
        <!-- Style für ausgewählte Bildkachel -->
        <Style x:Key="ImageTileStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#FF2196F3"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="Background" Value="#FFF0F8FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Compact buttons for the 180 px image tiles (the global button padding would clip the icons) -->
        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="280"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Linke Spalte: Bildauswahl und Steuerung -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Background="#FF2196F3" Margin="0,0,0,10">
                <TextBlock Text="🗺️ Bild Georeferenzierung" 
                           FontSize="20" FontWeight="Bold" 
                           Foreground="White" Margin="10" 
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ImageCountText" Text="0 Bilder geladen" 
                           FontSize="12" Foreground="White" 
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
            </StackPanel>

            <!-- Bildkachelansicht -->
            <Border Grid.Row="1" BorderBrush="#FFCCCCCC" BorderThickness="1" 
                    Margin="10,0,10,10" Background="#FFF5F5F5">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ImageItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ImageTileStyle}" 
                                            Width="180"
                                            MouseLeftButtonDown="ImageTile_Click"
                                            ToolTip="{Binding FileName}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="150"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Thumbnail-Bereich mit Hintergrund -->
                                            <Border Grid.Row="0" 
                                                    Background="#FFF5F5F5" 
                                                    BorderBrush="#FFDDDDDD" 
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <!-- Eigentliches Thumbnail -->
                                                    <Image Source="{Binding Thumbnail}" 
                                                           Stretch="Uniform" 
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           MaxHeight="140"
                                                           MaxWidth="170"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Margin="5"/>
                                                    
                                                    <!-- GPS Badge -->
                                                    <Border Background="#FF4CAF50" 
                                                            CornerRadius="3" 
                                                            Padding="5,2"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="5">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasGpsData}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="📍 GPS" 
                                                                   Foreground="White" 
                                                                   FontSize="10" 
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            
                                            <!-- GPS Info -->
                                            <TextBlock Grid.Row="1" 
                                                       Text="{Binding GpsInfo}" 
                                                       FontSize="9" 
                                                       Foreground="#FF666666"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,5"/>
                                            
                                            <!-- Trassenzuordnung -->
                                            <TextBlock Grid.Row="2" Text="{Binding RouteInfo}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#FF1971C2" TextAlignment="Center" Margin="0,0,0,4"/>

                                            <!-- Aktionsbuttons -->
                                            <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,2">
                                                <Button Style="{StaticResource TileButton}" Content="✏" Background="#FF2196F3"
                                                        Click="EditImage_Click" Tag="{Binding}" ToolTip="Bearbeiten"/>
                                                <Button Style="{StaticResource TileButton}" Content="💾" Background="#FF28A745"
                                                        Click="SaveSingleImage_Click" Tag="{Binding}" ToolTip="Speichern (Kopie mit GPS)"/>
                                                <Button Style="{StaticResource TileButton}" Content="↶" Background="#FF6C757D" FontSize="15"
                                                        Click="UndoImage_Click" Tag="{Binding}" IsEnabled="{Binding CanUndo}"
                                                        ToolTip="Letzte Änderung an diesem Bild rückgängig machen"/>
                                                <Button Style="{StaticResource TileButton}" Content="✕" Background="#FFDC3545"
                                                        Click="RemoveImage_Click" Tag="{Binding}" ToolTip="Aus der Liste entfernen (Datei bleibt erhalten)"/>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Drag & Drop Hinweis -->
                    <TextBlock x:Name="DropHintText" 
                               Text="📸 Ziehen Sie Bilder hierher&#x0a;oder klicken Sie auf 'Bilder laden'"
                               FontSize="16" Foreground="#FF999999" 
                               TextAlignment="Center" VerticalAlignment="Center"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               Margin="20"/>
                </Grid>
            </Border>

            <!-- Aktionsbuttons -->
            <StackPanel Grid.Row="2" Margin="10,0,10,10">
                <Button x:Name="LoadImagesButton" Content="📁 Bilder laden" 
                        Height="40" Margin="0,0,0,5" Click="LoadImagesButton_Click"
                        Background="#FF4CAF50" Foreground="White" FontWeight="Bold" FontSize="14"/>
                <Button Content="KI-Metadaten · Batch &amp; Chat" Height="36" Margin="0,0,0,5" Click="AiMetadata_Click"/>
                <Button x:Name="UseReferenceImageButton" Content="📌 Referenzbild verwenden" 
                        Height="35" Margin="0,0,0,5" Click="UseReferenceImageButton_Click" FontSize="13"/>
                <Button x:Name="SaveAllButton" Content="💾 Alle speichern" 
                        Height="40" Margin="0,0,0,5" Click="SaveAllButton_Click"
                        Background="#FF2196F3" Foreground="White" FontWeight="Bold" FontSize="14"
                        IsEnabled="False"/>
                <Button x:Name="CommitGPSToAllPicturesButton" Content="💾 GPS auf alle Bilder anwenden und speichern" 
            Height="40" Margin="0,0,0,5" Click="CommitGPSToAllPictures_Click"
            Background="#FF2196F3" Foreground="White" FontWeight="Bold" FontSize="14"
            IsEnabled="False"/>
                <Button x:Name="ClearAllButton" Content="🗑️ Alle entfernen" 
                        Height="35" Margin="0,0,0,5" Click="ClearAllButton_Click"
                        Background="#FFFF9800" Foreground="White" FontSize="13"/>
            </StackPanel>

            <!-- GPS Info Panel -->
            <Border Grid.Row="3" Background="#FFFFE082" Padding="10" Margin="10,0,10,10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="📍 Aktuelle GPS-Koordinaten" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                    <TextBlock x:Name="CurrentGpsText" Text="Keine Koordinaten ausgewählt" 
                               TextWrapping="Wrap" FontSize="12" Margin="0,0,0,5"/>
                    <Button x:Name="ApplyGpsButton" Content="GPS auf ausgewähltes Bild anwenden" 
                            Height="30" Margin="0,5,0,0" Click="ApplyGpsButton_Click"
                            IsEnabled="False" FontSize="12"/>
                    
                    <Separator Margin="0,10,0,10"/>
                    
                    <TextBlock Text="💾 Speicherort" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                    <TextBox x:Name="OutputFolderTextBox" IsReadOnly="True" 
                             TextWrapping="Wrap" Margin="0,0,0,5"
                             Background="White" Padding="5" Height="40" FontSize="11"/>
                    <Button x:Name="ChangeOutputFolderButton" Content="Speicherort ändern" 
                            Height="25" Click="ChangeOutputFolderButton_Click" FontSize="12"/>
                    <Separator Margin="0,10,0,10"/>

                    <!-- Lizenz-Button (standardkonform am unteren Ende) -->
                    <Button x:Name="ShowLicensesButton" Content="📜 Lizenzen anzeigen" 
                                Height="30" Click="ShowLicensesButton_Click" FontSize="12"
                                 Background="#FF607D8B" Foreground="White"/>
                </StackPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                      Background="#FFCCCCCC"/>

        <!-- Rechte Spalte: Karte mit voller Höhe -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Karten-Header -->
            <Border Grid.Row="0" Background="#FF1976D2" Padding="10">
                <TextBlock Text="🗺️ Karte · Doppelklick setzt neue GPS-Koordinaten" 
                           FontSize="16" FontWeight="Bold" 
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Karten-Steuerung -->
            <Border Grid.Row="1" Background="#FFF0F0F0" Padding="10" BorderBrush="#FFCCCCCC" BorderThickness="0,0,0,1">
                <StackPanel>
                    <!-- Bild-/Trasseninfo: ersetzt Popups auf der Karte -->
                    <TextBlock x:Name="MapInfoText" Text="Kein Bild ausgewählt" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                    <TextBlock x:Name="MapStatusText" Text="Karte wird geladen …" TextWrapping="Wrap"
                               FontSize="11" Foreground="#FF555555" Margin="0,0,0,8"/>

                    <!-- Layer und Trassen -->
                    <WrapPanel Margin="0,0,0,4">
                        <CheckBox x:Name="ShowRoutesCheckBox" Content="Trassen (Luftlinie)" IsChecked="True" Margin="0,0,16,0"
                                  VerticalAlignment="Center" Checked="Layer_Changed" Unchecked="Layer_Changed"/>
                        <CheckBox x:Name="ShowImagesCheckBox" Content="Bilder anzeigen" IsChecked="True" Margin="0,0,16,0"
                                  VerticalAlignment="Center" Checked="Layer_Changed" Unchecked="Layer_Changed"/>
                        <CheckBox x:Name="SortByRouteCheckBox" Content="Bildliste nach Trasse ordnen" IsChecked="True" Margin="0,0,16,0"
                                  VerticalAlignment="Center" Checked="RouteSettings_Changed" Unchecked="RouteSettings_Changed"
                                  ToolTip="Reihenfolge entlang der Trasse: Süd→Nord bzw. West→Ost"/>
                        <TextBlock Text="Max. Punktabstand je Trasse:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="RouteGapSlider" Width="140" Minimum="25" Maximum="1000" Value="200" TickFrequency="25"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="RouteGap_Changed"
                                ToolTip="Punkte, die weiter auseinanderliegen, bilden eine neue Trasse"/>
                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" Margin="6,0,0,0">
                            <Run Text="{Binding Value, ElementName=RouteGapSlider, StringFormat={}{0:F0}}"/><Run Text=" m"/>
                        </TextBlock>
                        <TextBlock Text="Abzweig ab:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <Slider x:Name="BranchMinSlider" Width="100" Minimum="3" Maximum="50" Value="10" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="BranchMin_Changed"
                                ToolTip="Fotos, die weiter als dieser Abstand neben dem Hauptstrang liegen, werden als Abzweig (z. B. Hausanschluss) senkrecht angebunden"/>
                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" Margin="6,0,0,0">
                            <Run Text="{Binding Value, ElementName=BranchMinSlider, StringFormat={}{0:F0}}"/><Run Text=" m"/>
                        </TextBlock>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,4">
                        <Button x:Name="RoadMatchButton" Content="🛣 Trassen an Wege anlegen" Click="RoadMatch_Click" Margin="0,0,6,0"
                                ToolTip="Legt die Trassen über einen Routing-Server an Straßen, Geh- und Feldwege an. GPS-Daten der Fotos bleiben unverändert."/>
                        <Button Content="⚙" Click="RoadSettings_Click" Margin="0,0,12,0" MinWidth="32" ToolTip="Routing-Server, Wegeprofil, maximaler Abstand"/>
                        <CheckBox x:Name="ShowRoadCheckBox" Content="Wegverlauf anzeigen" IsChecked="True" Margin="0,0,12,0"
                                  VerticalAlignment="Center" Checked="Layer_Changed" Unchecked="Layer_Changed"/>
                        <TextBlock x:Name="RoadServerText" VerticalAlignment="Center" FontSize="11" Foreground="#FF555555"/>
                    </WrapPanel>

                    <!-- Raster-Steuerung -->
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <CheckBox x:Name="GridEnabledCheckBox" 
                                  Grid.Column="0"
                                  Content="Raster anzeigen:" 
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Checked="GridEnabled_Changed"
                                  Unchecked="GridEnabled_Changed"/>
                        
                        <Slider x:Name="GridSizeSlider" 
                                Grid.Column="1"
                                Minimum="100" 
                                Maximum="200" 
                                Value="100" 
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                ValueChanged="GridSize_Changed"
                                IsEnabled="{Binding IsChecked, ElementName=GridEnabledCheckBox}"/>
                        
                        <TextBlock Grid.Column="2" 
                                   VerticalAlignment="Center"
                                   FontWeight="Bold">
                            <Run Text="{Binding Value, ElementName=GridSizeSlider, StringFormat={}{0:F0}}"/>
                            <Run Text=" m"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Karte -->
            <wv2:WebView2 x:Name="MapWebView" Grid.Row="2"/>
        </Grid>
    </Grid>
</Window>
